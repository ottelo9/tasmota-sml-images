TinyC Examples (gemu2015)|https://raw.githubusercontent.com/gemu2015/Sonoff-Tasmota/universal/tasmota/tinyc␀<fieldset><legend><b> Repository </b></legend>␀␀<div style='display:flex;gap:8px;align-items:center;margin-bottom:6px'><select id='tcrp' style='flex:1'>␀␀␀␀%s/bytecode␀<option value='%s'%s>%s</option>␀␀␀␀<div style='display:flex;gap:8px;align-items:center'><select id='tcrf' style='flex:1'><option>loading...</option></select><button type='button' id='tcrib' class='button' style='width:auto;padding:0 10px;line-height:2rem;font-size:1rem' title='Info' onclick='tcrI()'>i</button><select id='tcrs' style='width:auto'>␀␀␀</select></div><br><button id='tcdlb' class='button bgrn' onclick='tcDl()'>Download &amp; Load</button> <button class='button' style='background:#888' onclick='tcFill(1)'>&#x21bb; Refresh list</button><div id='tcrmsg' style='font-size:.85em;opacity:.7;margin-top:4px'></div></fieldset>␀␀␀<script>var TCREPO='%s';function tcB(){var b=TCREPO;return b.charAt(b.length-1)=='/'?b.slice(0,-1):b}function tcLb(e){var n=e.name||e.n||'',f=e.file||e.f||'';if(f.slice(-4)=='.tcb')f=f.slice(0,-4);return n?n:f}function tcVd(x){var m=(x||'').match(/^(\d\d)(\d\d)(\d\d)(\d\d)_\d{4}$/);return m?m[4]+'.'+m[3]+'.'+m[2]:''}function tcOpt(s,f,n,u,v){var o=document.createElement('option'),b=f.slice(-4)=='.tcb'?f.slice(0,-4):f,d=tcVd(v);o.value=f;o.textContent=(n?n:b)+(d?' \u00b7 '+d:'');if(u)o.dataset.u=u;s.appendChild(o)}function tcV(x){var m=x.match(/^(\d\d)(\d\d)(\d\d)(\d\d)_(\d\d)(\d\d)$/);return m?m[4]+'.'+m[3]+'.'+m[2]+' '+m[5]+':'+m[6]:x}function tcUp(ls){document.querySelectorAll('.tc-row[data-f]').forEach(function(r){var o=r.querySelector('.tc-up');if(o)o.remove();var e=ls.filter(function(x){return (x.file||x.f)==r.dataset.f})[0];if(!e||!e.version)return;var nv=e.version,ov=r.dataset.v||'',re=/^\d{8}_\d{4}$/;if(nv==ov||(re.test(nv)&&re.test(ov)&&nv<ov))return;var s=document.createElement('button');s.type='button';s.className='button tc-up';s.title='Update';s.innerHTML='&#x1F504; '+tcV(nv);s.onclick=function(){tcUpd(r.dataset.f,r.dataset.s,e.name||e.n||r.dataset.f)};r.querySelector('.tc-info').appendChild(s)})}function tcUpd(f,sl,n){var a=document.getElementById('tcrf'),b=document.getElementById('tcrs');a.value=f;b.value=sl;if(a.value!=f||b.value!=sl)return;if(!confirm('Update: '+n+' -> Slot '+sl+'?'))return;tcDl()}function tcrU(){var s=document.getElementById('tcrf');return s&&s.selectedIndex>=0?(s.options[s.selectedIndex].dataset.u||''):''}function tcrI(){var u=tcrU();if(u)window.open(u,'_blank','noopener')}function tcrW(){try{sessionStorage.setItem('tcrf',document.getElementById('tcrf').value)}catch(e){}}function tcrL(){var s=document.getElementById('tcrf'),v='';try{v=sessionStorage.getItem('tcrf')||''}catch(e){}if(v)for(var i=0;i<s.options.length;i++)if(s.options[i].value==v){s.selectedIndex=i;break}tcrS()}function tcrS(){var b=document.getElementById('tcrib');if(!b)return;b.disabled=!tcrU();b.style.opacity=b.disabled?'.35':'1';b.title=b.disabled?'Kein Info-Link hinterlegt':'Info'}function tcTxt(s,f){return fetch(tcB()+'/index.txt',{cache:f?'reload':'default'}).then(function(r){if(!r.ok)throw r.status;return r.text()}).then(function(t){var ls=t.split(String.fromCharCode(10)).map(function(x){return x.trim()}).filter(function(x){return x.slice(-4)=='.tcb'}).sort(function(a,b){a=a.toLowerCase();b=b.toLowerCase();return a<b?-1:a>b?1:0});s.innerHTML='';if(!ls.length){s.innerHTML='<option>(empty)</option>';return}ls.forEach(function(n){tcOpt(s,n,'','')})})}function tcFill(f){var s=document.getElementById('tcrf');var m0=document.getElementById('tcrmsg');if(m0)m0.textContent='';fetch(tcB()+'/index.json',{cache:f?'reload':'default'}).then(function(r){if(!r.ok)throw r.status;return r.json()}).then(function(j){var ls=(j&&j.programs)||j;if(!ls||!ls.length)throw 'empty';if(!j.ordered)ls=ls.filter(function(e){return !e.sep}).sort(function(a,b){return tcLb(a).localeCompare(tcLb(b),undefined,{sensitivity:'base'})});s.innerHTML='';ls.forEach(function(e){if(e.sep){var q=document.createElement('option');q.disabled=1;q.textContent=Array(21).join('\u2500');s.appendChild(q);return}var u=e.info||'';if(u&&u.slice(0,7)!='http://'&&u.slice(0,8)!='https://')u='';tcOpt(s,e.file||e.f||'',e.name||e.n||'',u,e.version)});tcrL();tcUp(ls)}).catch(function(){return tcTxt(s,f).then(tcrL)}).catch(function(e){s.innerHTML='<option>(list failed)</option>';tcrS();document.getElementById('tcrmsg').textContent='Repo list fetch failed: '+e})}function tcDl(){var f=document.getElementById('tcrf').value,sl=document.getElementById('tcrs').value,b=document.getElementById('tcdlb'),m=document.getElementById('tcrmsg');if(!f||f.charAt(0)=='('){return}b.disabled=1;b.textContent='Downloading...';m.textContent='';fetch(tcB()+'/'+f).then(function(r){if(!r.ok)throw r.status;return r.arrayBuffer()}).then(function(buf){var fd=new FormData();fd.append('file',new Blob([buf]),f);return fetch('/tc_upload?api=1&slot='+sl+'&fsz='+buf.byteLength,{method:'POST',body:fd})}).then(function(r){if(!r.ok)throw r.status;m.textContent='Loaded '+f+' to slot '+sl+', reloading...';setTimeout(function(){location.reload()},900)}).catch(function(e){b.disabled=0;b.textContent='Download & Load';m.textContent='Failed: '+e})}document.getElementById('tcrf').addEventListener('change',function(){tcrW();tcrS()});var TCBASE='';(function(){var s=document.getElementById('tcrp');if(!s){try{localStorage.removeItem('tinyc_base')}catch(e){}return}try{var v=localStorage.getItem('tinyc_base');if(v)for(var i=0;i<s.options.length;i++)if(s.options[i].value==v){s.selectedIndex=i;break}}catch(e){}function ap(){TCBASE=s.value;TCREPO=TCBASE+'/bytecode';try{localStorage.setItem('tinyc_base',TCBASE)}catch(e){}}ap();s.addEventListener('change',function(){ap();try{sessionStorage.removeItem('tcrf')}catch(e){}tcFill(1)});})();tcFill(0);</script>␀␀<fieldset><legend><b> TinyC VM </b></legend><p style='text-align:center;opacity:.6'>TinyC not initialized</p></fieldset>␀␀␀␀<fieldset><legend><b> Upload Program </b></legend><form class='tc-upload' method='POST' action='/tc_upload' enctype='multipart/form-data' onsubmit="var f=this.querySelector('[name=tcb]').files[0];this.action='/tc_upload?slot='+this.querySelector('[name=uslot]').value+(f?'&fsz='+f.size:'')"><div style='display:flex;gap:8px;align-items:center'><input type='file' name='tcb' accept='.tcb' style='flex:1'><select name='uslot' style='width:auto'>␀</select></div><button type='submit' class='button bgrn'>Upload .tcb</button></form></fieldset>␀<fieldset><legend><b> TinyC IDE </b></legend>␀␀␀/tinyc_ide.html.gz␀␀, about %u kB␀␀␀<p style='text-align:center'><button onclick="window.open('/ide','tinyc_ide')" class='button bgrn'>Open IDE</button> <button id='tcide_upd' onclick="if(!confirm('Update the IDE from the repository? (downloads tinyc_ide.html.gz%s, and replaces the served IDE)'))return;var b=this;b.disabled=1;b.textContent='Updating...';fetch('/cm?cmnd=TinyCIde'+(window.TCBASE?' '+encodeURIComponent(window.TCBASE+'/tinyc_ide.html.gz'):'')).then(r=>r.json()).then(j=>{var d=j.TinyCIde||{};if(d.updated){b.textContent='Updated '+d.updated+' B';alert('IDE updated ('+d.updated+' bytes)'+(d.flash?' and stored in the flash file system, because writing to the SD card was cut short':'')+'. Re-open the IDE.');}else{b.disabled=0;b.textContent='Update IDE';alert('IDE update failed: '+(d.msg||('error '+d.error))+(d.kept?'\n\nThe old IDE was kept.':''));}}).catch(e=>{b.disabled=0;b.textContent='Update IDE';alert('IDE update request failed.');});" class='button'>Update IDE</button></p><p style='text-align:center;font-size:.85em;opacity:.6'>Served from device filesystem (port 82 background task on real hw, port 80 fallback otherwise). "Update IDE" fetches the latest from the repo &mdash; no file manager needed.</p>␀␀<p style='text-align:center'><button onclick="window.open('/tcrepo','tinyc_repo')" class='button'>Run IDE from repo</button></p><p style='text-align:center;font-size:.85em;opacity:.6'>The full IDE, fetched from the repo into the browser -- edit and run without any IDE on the device. It asks this device for its ABI and compiles to match. Needs internet in the browser; the on-device IDE works offline.</p>␀␀<script>if(window.BroadcastChannel){var _tc=new BroadcastChannel('tinyc');_tc.onmessage=function(e){if(e.data=='refresh')location.reload();}}</script>␀␀<script>document.addEventListener('visibilitychange',function(){if(!document.hidden)location.reload();});</script>␀␀%c%c.%c%c.%c%c %c%c:%c%c␀␀␀␀content-length␀␀/autoexec.tcb␀␀␀TCC: /tc_upload got a non-multipart (raw) body â€” rejected (use multipart / curl -F)␀␀␀TCC: Upload start: %s (slot %d)␀TCC: Upload refused: file name %s is too long (%u characters, at most %u including the .tcb)␀␀␀␀TCC: Upload: slot %d unloaded first (%u B program freed, largest block %u)␀␀TCC: Upload malloc(%u) failed, freeing slot %d's program (%u B) and retrying␀␀␀␀TCC: Upload malloc(%u, from %s) failed â€” free heap=%u largest block=%u␀␀␀␀TCC: Upload buffer %u B from %s, largest block now %u␀␀␀TCC: Upload too large (received %u + chunk %u > cap %u)␀TCC: Loaded %d bytes into slot %d␀␀␀TCC: Saved to %s␀␀␀␀TCC: Load error: %s␀TCC: Load OOM â€” retrying from %s␀␀TCC: Loaded from file after OOM (slot %d)␀␀␀{"ok":false,"error":"not initialized"}␀␀{"ok":false,"error":"no program loaded"}␀␀␀␀{"ok":false,"error":"start failed"}␀TCC: Program started %s (API, slot %d)␀␀{"ok":true,"running":true,"size":%d,"slot":%d,"file":"%s"}␀␀TCC: Program stopped (API, slot %d)␀{"ok":true,"running":false}␀TCC: Slot %d autoexec=%d (API)␀␀{"ok":true,"slot":%d,"autoexec":%d}␀{"ok":true,"release":"1.6.73","tcb":␀␀␀␀,"abi":␀,"slots":[␀␀{"slot":%d,"loaded":%d,"running":%d,"autoexec":%d,"size":%d,"file":"%s","pc":%d,"sp":%d,"instr":%u,"ram":%u,"error":"%s"}␀␀␀{"slot":%d,"loaded":0,"running":0,"autoexec":%d,"size":0,"file":"%s","pc":0,"sp":0,"instr":0,"ram":0,"error":"OK"}␀␀],"heap":␀␀␀,"frag":␀␀␀␀,"maxblk":␀␀,"blocks":␀␀,"holes":␀␀␀application/json␀␀␀␀freegpio␀␀␀␀{"ok":tr