{
  "name": "esp32-camera",
  "version": "2.0.0",
  "keywords": "esp32, camera, espressif, esp32-cam",
  "description": "ESP32 compatible driver for OV2640, OV3660, OV5640, OV7670 and OV7725 image sensors.",
  "repository": {
    "type": "git",
    "url": "https://github.com/espressif/esp32-camera"
  },
  "frameworks": "*",
  "platforms": "espressif32",
  "build": {
    "flags": [
      "-Idriver/include",
      "-Iconversions/include",
      "-Idriver/private_include",
      "-Iconversions/private_include",
      "-Isensors/private_include",
      "-Itarget/private_include",
      "-fno-rtti"
    ],
    "includeDir": ".",
    "srcDir": ".",
    "srcFilter": [
      "-<*>",
      "+<driver>",
      "+<driver/sccb-ng.c>",
      "-<driver/sccb.c>",
      "-<driver/esp_camera_af.c>",
      "+<conversions>",
      "+<sensors/ov3660.c>",
      "+<sensors/ov2640.c>",
      "+<sensors/ov5640.c>",
      "+<sensors/ov7670.c>",
      "+<sensors/ov7725.c>",
      "+<sensors/nt99141.c>",
      "+<target/esp32>",
      "+<target/esp32s3>"
    ]
  }
}
